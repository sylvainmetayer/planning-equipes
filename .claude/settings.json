{
  "permissions": {
    "allow": [
      "Bash(./mvnw -q compile *)",
      "Bash(./mvnw -q -o compile *)",
      "Bash(./mvnw -q test-compile *)",
      "Bash(mvn -q -o compile *)",
      "Bash(docker info *)",
      "Bash(podman info *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-flyway-migrations.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-doc-layout.sh"
          }
        ]
      }
    ]
  }
}
