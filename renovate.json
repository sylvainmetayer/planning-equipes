{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":maintainLockFilesDisabled"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "enabledManagers": [
    "maven",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "mise"
  ],
  "packageRules": [
    {
      "description": "Quarkus platform and extensions move together",
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.quarkus{/,}**", "io.quarkus.platform{/,}**"],
      "groupName": "quarkus",
      "addLabels": ["quarkus"]
    },
    {
      "description": "Timefold solver artifacts move together",
      "matchManagers": ["maven"],
      "matchPackageNames": ["ai.timefold.solver{/,}**"],
      "groupName": "timefold solver",
      "addLabels": ["timefold"]
    },
    {
      "description": "Test-only dependencies: one grouped PR for minor and patch",
      "matchManagers": ["maven"],
      "matchDepTypes": ["test"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "test dependencies"
    },
    {
      "description": "Maven build plugins: one grouped PR for minor and patch",
      "matchManagers": ["maven"],
      "matchDepTypes": ["build", "plugin"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "maven build plugins"
    },
    {
      "description": "GitHub Actions: one grouped PR for minor and patch",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "Container base images used by the app and the tests",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "container images"
    },
    {
      "description": "Java major upgrades touch Dockerfiles, mise.toml, the pom and the workflows: handle them manually",
      "matchPackageNames": [
        "eclipse-temurin",
        "maven",
        "java",
        "registry.access.redhat.com/**"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "java toolchain (major)",
      "dependencyDashboardApproval": true
    },
    {
      "description": "PostgreSQL major upgrades imply a data migration",
      "matchPackageNames": ["postgres", "docker.io/postgres"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true
}
