<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.sylvain</groupId>
    <artifactId>planning-equipes</artifactId>
    <!-- CI-friendly version (docs/versioning.md) : the Docker build derives it
         from the git tag being built (-Drevision=1.2.0) so
         quarkus.application.version — the Quarkus startup line — reports the
         released version. Everywhere else the default below applies, and
         deliberately looks like no release. -->
    <version>${revision}</version>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <revision>999-SNAPSHOT</revision>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.38.3</quarkus.platform.version>
        <timefold.solver.version>2.5.0</timefold.solver.version>
        <quinoa.version>2.9.0</quinoa.version>
        <sentry.version>8.57.0</sentry.version>
        <!-- Kept aligned with the jackson-databind version Flyway pulls in
             transitively (see quarkus-flyway), so the YAML/JSR-310 modules
             used by the scenario DTOs (dev.sylvain.planning.scenario) stay
             on the same Jackson release as the rest of the classpath. -->
        <jackson-yaml.version>2.22.2</jackson-yaml.version>
        <jsonschema-generator.version>4.38.0</jsonschema-generator.version>
        <mcp-server.version>1.13.2</mcp-server.version>
        <!-- The MIT build of PlantUML: renders docs/diagrammes/ (profile
             generate-diagrams) and lets DiagramsStructuralTest decode the
             source each SVG embeds. Test scope, so it stays out of the image
             and of docs/licences-tierces.md. -->
        <plantuml.version>1.2026.8</plantuml.version>
        <skipITs>true</skipITs>
        <!-- Mot de passe admin des tests d'intégration : ils lancent
             l'application packagée en %prod, où la valeur d'exemple est
             refusée au démarrage. -->
        <it.admin.password>it-admin-Hs3vQ9zR</it.admin.password>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <spotless-plugin.version>3.10.2</spotless-plugin.version>
        <palantir-java-format.version>2.98.0</palantir-java-format.version>
        <license-plugin.version>2.7.1</license-plugin.version>
        <!-- Full-scale scenario regression tests (@Tag("scenario-lent"):
             PlanningServiceScenarioCompletTest, PlanningServiceScenarioContinuTest)
             solve a ~2000-poste problem to hard-feasibility and take ~25-75s
             each — excluded from the default `./mvnw test`/CI run so the
             everyday inner loop stays fast; run them explicitly with
             `./mvnw test -Pscenario-tests` (see the scenario-tests profile
             below), which clears this property. The @Tag("scenario-extreme")
             tests — the limits of the solver and the import, measured in
             minutes and gigabytes — are excluded from both and run only with
             `-Pscenario-extreme`. -->
        <test.excludedGroups>scenario-lent,scenario-extreme</test.excludedGroups>
        <test.groups></test.groups>
        <!-- Silences a JDK 25 native-access warning from JNA (loaded by
             Quarkus's interactive dev-mode console) in the JVM forked by
             quarkus:dev, quarkus:test and quarkus:run. Quarkus 3.28+ already
             enables native access for Netty on its own, and Netty's
             sun.misc.Unsafe usage no longer warns on this version, so only
             the JNA-related flag is still needed here. -->
        <jvm.args>--enable-native-access=ALL-UNNAMED</jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- Operating metrics in the Prometheus format (solver, HTTP, SMTP,
             backup), served on the management interface only — a port the
             production stack never publishes. See docs/observabilite.md. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Nightly database backup (dev.sylvain.planning.service.backup): the
             only scheduled job in the application. Disabled under %test, where
             a cron firing mid-suite would shell out to pg_dump. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- Backs the MCP API-key check (dev.sylvain.planning.mcp):
             quarkus.http.auth.permission.* policies are what expresses "this
             path needs the mcp role" once, for every extension that mounted a
             path. A Vert.x filter does see the quarkus-mcp-server-http routes
             (McpRateLimiter is one), but it can only re-implement a check the
             policy engine already owns. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <!-- Échange notifications (issue #165): a mail to the admin when
             demandes are submitted, a mail to the animateur when one is
             decided. Mocked in dev/test unless an SMTP host is configured
             (docker-compose ships Mailpit for local testing). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mailer</artifactId>
        </dependency>
        <!-- Every mail body is a Qute template under resources/templates/mail:
             one .txt and one .html per mail, the HTML ones sharing a layout
             carrying the deployment's branding. See docs/architecture.md. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-qute</artifactId>
        </dependency>
        <!-- Admin authentication (issue #165): single admin account defined in
             configuration (embedded users), form login with an encrypted
             session cookie. Replaced by OIDC later without touching the
             HTTP permission layout. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-elytron-security-properties-file</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
            <version>${timefold.solver.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>3.0.5</version>
        </dependency>
        <!-- QR encoding only: OpenPDF draws no barcode of its own, and the
             espace's link is what an animateur scans off their printed PDF.
             Apache-2.0, no transitive dependency. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.7</version>
        </dependency>
        <!-- dev.sylvain.planning.scenario: standalone
             scenario-file DTOs, validated with Bean Validation and used to
             derive the JSON
             Schema published at docs/schema/scenario-schema.json (see
             docs/import-export.md and the generate-schema Maven profile).
             Plain Jakarta Bean Validation + reference impl, not the
             quarkus-hibernate-validator extension, since this tool runs
             standalone via exec:java and doesn't need CDI/Quarkus
             augmentation. Versions come from the Quarkus BOM above. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson-yaml.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson-yaml.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Stays `compile`, deliberately: quarkus-mcp-server-core depends
                 on it non-optionally, so it ships whatever we say. Declaring it
                 here is what pins the version that ships — and `provided` is
                 precisely what would stop doing that: Maven resolves our
                 version, then drops it from the runtime classpath and the
                 Quarkus resolver puts the extension's own back. Measured: with
                 the property at 4.37.0, `compile` ships 4.37.0 and `provided`
                 ships 4.38.0. The Renovate rule below guards that pin. -->
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jackson</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Build tooling, not runtime. quarkus-mcp-server-core marks this
                 module `optional`, so it only shipped because we declared it:
                 `provided` takes it out of the image, out of the signed SBOM and
                 out of the Trivy scan. Its only user is
                 ScenarioSchemaGenerator, under the opt-in generate-schema
                 profile, whose exec plugin asks for the compile classpath. -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jakarta-validation</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Build tooling, not runtime. quarkus-mcp-server-core marks this
                 module `optional`, so it only shipped because we declared it:
                 `provided` takes it out of the image, out of the signed SBOM and
                 out of the Trivy scan. Its only user is
                 ScenarioSchemaGenerator, under the opt-in generate-schema
                 profile, whose exec plugin asks for the compile classpath. -->
            <scope>provided</scope>
        </dependency>
        <!-- MCP (Model Context Protocol) server: exposes a curated,
             privacy-filtered set of tools (see dev.sylvain.planning.mcp)
             so an AI assistant can query/drive the planning app in natural
             language. Streamable-HTTP transport, so it rides the existing
             Quarkus HTTP server instead of opening a separate stdio process
             ("quarkus-mcp-server-sse" is the older SSE-only transport,
             relocated to this artifact as of 1.13.x). -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
            <version>${mcp-server.version}</version>
        </dependency>
        <!-- Builds and serves the Angular frontend of src/main/webui. -->
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>
        <!-- Error tracking. No Quarkus extension exists for Sentry, so this is
             the plain Java SDK, initialized manually (see SentryInitializer)
             and pointed at a Sentry-protocol-compatible ingest endpoint
             (Bugsink) via the SENTRY_DSN env var. -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry</artifactId>
            <version>${sentry.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waits on the condition an asynchronous test actually expects
             (a solve landing, a job leaving the queue) instead of a
             Thread.sleep; version managed by the Quarkus BOM. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml-mit</artifactId>
            <version>${plantuml.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Formatting is not a review topic: palantir-java-format decides,
                     `./mvnw spotless:apply` obeys, and `validate` refuses a file
                     that was not run through it (audit #392, C10). The unused
                     imports and the import order go with it. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-plugin.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} ${jvm.args}</argLine>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <groups>${test.groups}</groups>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine} ${jvm.args}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                    <!-- Les *IT lancent l'application packagée, donc en profil
                         %prod : DefaultSecrets y refuse les mots de passe
                         d'exemple, et RequiredMentionsLegales une page de
                         mentions légales vide. Ces valeurs leur donnent un vrai
                         mot de passe, comme la garde le demande à un
                         exploitant, et déclarent ce que ces tests sont — une
                         instance qui n'est pas en service. Elles passent au
                         processus lancé, pas à celui de Maven. -->
                    <environmentVariables>
                        <ADMIN_PASSWORD>${it.admin.password}</ADMIN_PASSWORD>
                        <LEGAL_DEMO_INSTANCE>true</LEGAL_DEMO_INSTANCE>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- Third-party licence inventory, Java side. The image is
                     distributed under the AGPL, but it also redistributes the
                     jars it bundles, and the MIT/BSD/Apache notices of those
                     have to travel with it: `docs/licences-tierces.md` is
                     where they do (audit #392, D9).

                     Not bound to any phase — resolving the whole dependency
                     tree costs a build nobody asked for. It is invoked
                     explicitly by `npm run licences`, which merges this
                     output with the npm side, and by the Tests workflow,
                     which checks the committed inventory still matches.

                     `test` and `provided` are excluded because nothing in
                     those scopes ships: the image carries
                     `target/quarkus-app/`, which is compile + runtime. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-plugin.version}</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/licenses</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <excludedScopes>test,provided,system</excludedScopes>
                    <includeTransitiveDependencies>true</includeTransitiveDependencies>
                    <sortArtifactByName>true</sortArtifactByName>
                    <!-- A dependency whose POM declares no licence would
                         otherwise be listed as "Unknown license" and nobody
                         would look again. The inventory exists to be
                         complete; an unknown entry is a question to settle,
                         not a line to publish. -->
                    <failOnMissing>true</failOnMissing>
                    <!-- Six spellings of Apache-2.0, four of EPL-2.0: the
                         licence name in the inventory is whatever each POM
                         happened to type. Merged to the SPDX identifier, so
                         the same licence is one line in the summary instead
                         of six, and so a reader can compare two entries.
                         Only the label is merged — no judgement is made
                         about which text applies. -->
                    <licenseMerges>
                        <licenseMerge>Apache-2.0|Apache 2.0|Apache License 2.0|Apache License, Version 2.0|The Apache License, Version 2.0|The Apache Software License, Version 2.0</licenseMerge>
                        <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License - v 2.0|Eclipse Public License 2.0|Eclipse Public License v. 2.0</licenseMerge>
                        <licenseMerge>EPL-1.0|Eclipse Public License - v 1.0</licenseMerge>
                        <licenseMerge>EDL-1.0|EDL 1.0|Eclipse Distribution License - v 1.0</licenseMerge>
                        <licenseMerge>GPL-2.0-with-classpath-exception|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception|GNU General Public License, version 2, with the Classpath Exception</licenseMerge>
                        <licenseMerge>LGPL-2.1|GNU Lesser General Public License (LGPL), Version 2.1</licenseMerge>
                        <licenseMerge>MPL-2.0|Mozilla Public License Version 2.0</licenseMerge>
                        <licenseMerge>CC0-1.0|Public Domain, per Creative Commons CC0</licenseMerge>
                    </licenseMerges>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Opt-in: runs the @Tag("scenario-lent") full-scale scenario tests
             the default build excludes (see test.excludedGroups above). Not
             activated by CI — use ./mvnw test -Pscenario-tests locally, or in
             the background from an agent session (AGENTS.md). -->
        <profile>
            <id>scenario-tests</id>
            <properties>
                <test.excludedGroups>scenario-extreme</test.excludedGroups>
            </properties>
        </profile>
        <!-- Opt-in: runs only the @Tag("scenario-extreme") tests, the limits of
             the extreme-… files of src/main/resources/scenarios
             (docs/developpement.md). Heavy:
             run them one class at a time, in the foreground, with a heap to
             match — ./mvnw test -Pscenario-extreme -DargLine=-Xmx3g. -->
        <profile>
            <id>scenario-extreme</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
                <test.groups>scenario-extreme</test.groups>
            </properties>
        </profile>
        <!-- Opt-in: the inner loop, without a container (issue #475, D4 of
             #392). The classes listed in src/test/container-tests.txt boot the
             application, so they want a database; left out, what remains needs
             nothing but a JVM and answers in about eighty seconds where the
             whole suite takes twelve minutes — no Docker, no PostgreSQL, no
             dev services. The exclusion is by selection and not by tag on
             purpose: JUnit applies a tag filter after discovery, and
             discovery is already what boots Quarkus. That list is an
             inventory, kept exact by ContainerTestsInventoryTest.
             ./mvnw test -Punit while writing; the whole suite before pushing,
             since that is the one CI plays. -->
        <profile>
            <id>unit</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludesFile>src/test/container-tests.txt</excludesFile>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Opt-in: regenerates docs/schema/scenario-schema.json from the
             dev.sylvain.planning.scenario.dto classes (see
             ScenarioSchemaGenerator and docs/import-export.md). Not run by
             the default build or CI — use
             ./mvnw process-classes -Pgenerate-schema after changing a
             scenario DTO, and commit the regenerated file. -->
        <profile>
            <id>generate-schema</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>generate-scenario-schema</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>dev.sylvain.planning.scenario.ScenarioSchemaGenerator</mainClass>
                                    <!-- The victools jars are `provided`, which
                                         the default `runtime` scope leaves out. -->
                                    <classpathScope>compile</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Opt-in: renders every docs/diagrammes/*.puml into the .svg next
             to it (docs/developpement.md, « Diagrammes »). Not run by the
             default build — use ./mvnw validate -Pgenerate-diagrams after
             editing a diagram, and commit both files: the SVG embeds its
             source, and DiagramsStructuralTest fails when the two differ.
             The layouts use Smetana, PlantUML's Java port of Graphviz, so
             nothing but a JVM is needed. -->
        <profile>
            <id>generate-diagrams</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>generate-diagrams</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>net.sourceforge.plantuml.Run</mainClass>
                                    <!-- PlantUML is a test dependency. -->
                                    <classpathScope>test</classpathScope>
                                    <!-- PlantUML ends with System.exit. -->
                                    <blockSystemExit>true</blockSystemExit>
                                    <arguments>
                                        <argument>-tsvg</argument>
                                        <argument>-charset</argument>
                                        <argument>UTF-8</argument>
                                        <argument>-failfast2</argument>
                                        <argument>${project.basedir}/docs/diagrammes</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Measures test coverage with JaCoCo. CI activates it and publishes
             target/site/jacoco as an artifact (7 days), so the report is there
             when someone wants it; nothing consumes it — no threshold, no
             external service. Locally: ./mvnw test -Pcoverage, then open
             target/site/jacoco/index.html. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.15</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
