<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.sylvain</groupId>
    <artifactId>planning-equipes</artifactId>
    <!-- CI-friendly version (docs/versioning.md) : the Docker build derives it
         from the git tag being built (-Drevision=1.2.0) so
         quarkus.application.version — the Quarkus startup line — reports the
         released version. Everywhere else the default below applies, and
         deliberately looks like no release. -->
    <version>${revision}</version>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <revision>999-SNAPSHOT</revision>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.38.3</quarkus.platform.version>
        <timefold.solver.version>2.5.0</timefold.solver.version>
        <quinoa.version>2.9.0</quinoa.version>
        <sentry.version>8.53.0</sentry.version>
        <!-- Kept aligned with the jackson-databind version Flyway pulls in
             transitively (see quarkus-flyway), so the YAML/JSR-310 modules
             used by the scenario DTOs (dev.sylvain.planning.scenario) stay
             on the same Jackson release as the rest of the classpath. -->
        <jackson-yaml.version>2.22.0</jackson-yaml.version>
        <jsonschema-generator.version>4.38.0</jsonschema-generator.version>
        <mcp-server.version>1.13.1</mcp-server.version>
        <skipITs>true</skipITs>
        <!-- Mot de passe admin des tests d'intégration : ils lancent
             l'application packagée en %prod, où la valeur d'exemple est
             refusée au démarrage. -->
        <it.admin.password>it-admin-Hs3vQ9zR</it.admin.password>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <spotless-plugin.version>3.10.2</spotless-plugin.version>
        <palantir-java-format.version>2.98.0</palantir-java-format.version>
        <!-- Full-scale scenario regression tests (@Tag("scenario-lent"):
             PlanningServiceScenarioCompletTest, PlanningServiceScenarioContinuTest)
             solve a ~2000-poste problem to hard-feasibility and take ~25-75s
             each — excluded from the default `./mvnw test`/CI run so the
             everyday inner loop stays fast; run them explicitly with
             `./mvnw test -Pscenario-tests` (see the scenario-tests profile
             below), which clears this property. The @Tag("scenario-extreme")
             tests — the limits of the solver and the import, measured in
             minutes and gigabytes — are excluded from both and run only with
             `-Pscenario-extreme`. -->
        <test.excludedGroups>scenario-lent,scenario-extreme</test.excludedGroups>
        <test.groups></test.groups>
        <!-- Silences a JDK 25 native-access warning from JNA (loaded by
             Quarkus's interactive dev-mode console) in the JVM forked by
             quarkus:dev, quarkus:test and quarkus:run. Quarkus 3.28+ already
             enables native access for Netty on its own, and Netty's
             sun.misc.Unsafe usage no longer warns on this version, so only
             the JNA-related flag is still needed here. -->
        <jvm.args>--enable-native-access=ALL-UNNAMED</jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Nightly database backup (dev.sylvain.planning.service.backup): the
             only scheduled job in the application. Disabled under %test, where
             a cron firing mid-suite would shell out to pg_dump. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- Backs the MCP API-key check (dev.sylvain.planning.mcp):
             quarkus.http.auth.permission.* policies are the only mechanism that
             gates a path regardless of which extension mounted it (a plain
             io.quarkus.vertx.http.runtime.filters.Filter bean does not see
             requests routed by quarkus-mcp-server-http, which registers its
             own routes ahead of the global filter chain). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <!-- Échange notifications (issue #165): a mail to the admin when
             demandes are submitted, a mail to the animateur when one is
             decided. Mocked in dev/test unless an SMTP host is configured
             (docker-compose ships Mailpit for local testing). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mailer</artifactId>
        </dependency>
        <!-- Every mail body is a Qute template under resources/templates/mail:
             one .txt and one .html per mail, the HTML ones sharing a layout
             carrying the deployment's branding. See docs/architecture.md. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-qute</artifactId>
        </dependency>
        <!-- Admin authentication (issue #165): single admin account defined in
             configuration (embedded users), form login with an encrypted
             session cookie. Replaced by OIDC later without touching the
             HTTP permission layout. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-elytron-security-properties-file</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
            <version>${timefold.solver.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>
        <!-- dev.sylvain.planning.scenario: standalone
             scenario-file DTOs, validated with Bean Validation and used to
             derive the JSON
             Schema published at docs/schema/scenario-schema.json (see
             docs/import-export.md and the generate-schema Maven profile).
             Plain Jakarta Bean Validation + reference impl, not the
             quarkus-hibernate-validator extension, since this tool runs
             standalone via exec:java and doesn't need CDI/Quarkus
             augmentation. Versions come from the Quarkus BOM above. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson-yaml.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson-yaml.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Stays `compile`, deliberately: quarkus-mcp-server-core depends
                 on it non-optionally, so it ships whatever we say. Declaring it
                 here is what pins the version that ships — and `provided` is
                 precisely what would stop doing that: Maven resolves our
                 version, then drops it from the runtime classpath and the
                 Quarkus resolver puts the extension's own back. Measured: with
                 the property at 4.37.0, `compile` ships 4.37.0 and `provided`
                 ships 4.38.0. The Renovate rule below guards that pin. -->
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jackson</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Build tooling, not runtime. quarkus-mcp-server-core marks this
                 module `optional`, so it only shipped because we declared it:
                 `provided` takes it out of the image, out of the signed SBOM and
                 out of the Trivy scan. Its only user is
                 ScenarioSchemaGenerator, under the opt-in generate-schema
                 profile, whose exec plugin asks for the compile classpath. -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jakarta-validation</artifactId>
            <version>${jsonschema-generator.version}</version>
            <!-- Build tooling, not runtime. quarkus-mcp-server-core marks this
                 module `optional`, so it only shipped because we declared it:
                 `provided` takes it out of the image, out of the signed SBOM and
                 out of the Trivy scan. Its only user is
                 ScenarioSchemaGenerator, under the opt-in generate-schema
                 profile, whose exec plugin asks for the compile classpath. -->
            <scope>provided</scope>
        </dependency>
        <!-- MCP (Model Context Protocol) server: exposes a curated,
             privacy-filtered set of tools (see dev.sylvain.planning.mcp)
             so an AI assistant can query/drive the planning app in natural
             language. Streamable-HTTP transport, so it rides the existing
             Quarkus HTTP server instead of opening a separate stdio process
             ("quarkus-mcp-server-sse" is the older SSE-only transport,
             relocated to this artifact as of 1.13.x). -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
            <version>${mcp-server.version}</version>
        </dependency>
        <!-- Builds and serves the Angular frontend of src/main/webui. -->
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>
        <!-- Error tracking. No Quarkus extension exists for Sentry, so this is
             the plain Java SDK, initialized manually (see SentryInitializer)
             and pointed at a Sentry-protocol-compatible ingest endpoint
             (Bugsink) via the SENTRY_DSN env var. -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry</artifactId>
            <version>${sentry.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Formatting is not a review topic: palantir-java-format decides,
                     `./mvnw spotless:apply` obeys, and `validate` refuses a file
                     that was not run through it (audit #392, C10). The unused
                     imports and the import order go with it. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-plugin.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} ${jvm.args}</argLine>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <groups>${test.groups}</groups>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine} ${jvm.args}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                    <!-- Les *IT lancent l'application packagée, donc en profil
                         %prod : DefaultSecrets y refuse les mots de passe
                         d'exemple. Ces valeurs leur en donnent de vrais, comme
                         la garde le demande à un exploitant. Elles passent au
                         processus lancé, pas à celui de Maven. -->
                    <environmentVariables>
                        <ADMIN_PASSWORD>${it.admin.password}</ADMIN_PASSWORD>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Opt-in: runs the @Tag("scenario-lent") full-scale scenario tests
             the default build excludes (see test.excludedGroups above). Not
             activated by CI — use ./mvnw test -Pscenario-tests locally, or in
             the background from an agent session (AGENTS.md). -->
        <profile>
            <id>scenario-tests</id>
            <properties>
                <test.excludedGroups>scenario-extreme</test.excludedGroups>
            </properties>
        </profile>
        <!-- Opt-in: runs only the @Tag("scenario-extreme") tests, the limits of
             the extreme-… files of src/main/resources/scenarios
             (docs/developpement.md). Heavy:
             run them one class at a time, in the foreground, with a heap to
             match — ./mvnw test -Pscenario-extreme -DargLine=-Xmx3g. -->
        <profile>
            <id>scenario-extreme</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
                <test.groups>scenario-extreme</test.groups>
            </properties>
        </profile>
        <!-- Opt-in: regenerates docs/schema/scenario-schema.json from the
             dev.sylvain.planning.scenario.dto classes (see
             ScenarioSchemaGenerator and docs/import-export.md). Not run by
             the default build or CI — use
             ./mvnw process-classes -Pgenerate-schema after changing a
             scenario DTO, and commit the regenerated file. -->
        <profile>
            <id>generate-schema</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>generate-scenario-schema</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>dev.sylvain.planning.scenario.ScenarioSchemaGenerator</mainClass>
                                    <!-- The victools jars are `provided`, which
                                         the default `runtime` scope leaves out. -->
                                    <classpathScope>compile</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Measures test coverage with JaCoCo. CI activates it and publishes
             target/site/jacoco as an artifact (7 days), so the report is there
             when someone wants it; nothing consumes it — no threshold, no
             external service. Locally: ./mvnw test -Pcoverage, then open
             target/site/jacoco/index.html. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.15</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
