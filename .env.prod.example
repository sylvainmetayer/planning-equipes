# Environnement d'un déploiement de production.
#
#   cp .env.prod.example .env.prod   puis remplir, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Ne jamais committer le .env.prod rempli : il porte des secrets.
# Le mode d'emploi complet est dans docs/exploitation.md.

# ============================================================================
# OBLIGATOIRE — le démarrage échoue si l'une manque. C'est voulu : mieux vaut
# un refus de démarrer qu'un identifiant de développement — ou une image de
# recette — en production.
# ============================================================================

# Version déployée de l'application — un numéro de release (1.2.0), jamais
# `main` ni `latest` : un déploiement doit être nommable dans un rapport
# d'incident. Voir docs/versioning.md. Sans défaut, précisément parce qu'un
# défaut serait `main` : tant qu'aucune version n'est publiée, écrire
# `APP_VERSION=main` ici, en le sachant.
APP_VERSION=

# Mot de passe PostgreSQL, propre à ce déploiement.
DB_PASSWORD=

# Compte administrateur unique de l'application. Long, et propre à ce
# déploiement : il n'y a pas de second compte pour rattraper celui-ci.
ADMIN_PASSWORD=

# Clé de chiffrement des sessions admin, 16 caractères minimum. Sans clé fixe,
# toutes les sessions sont invalidées à chaque redémarrage.
SESSION_ENCRYPTION_KEY=

# URL publique, telle qu'un animateur la verra. Elle est IMPRIMÉE sur les PDF
# comme lien « espace animateur » : elle doit rester joignable après le
# festival, pas seulement pendant.
PUBLIC_URL=https://planning.example.org

# Serveur SMTP réel. L'espace animateur ne s'ouvre pas sans lui : c'est par là
# que partent les codes d'accès.
MAIL_HOST=
MAIL_FROM=planning@example.org

# ============================================================================
# COURRIER — le point le plus facile à rater, parce qu'il échoue en SILENCE.
# Un lien classé en indésirable ne produit ni erreur ni alerte.
# SPF, DKIM et DMARC se règlent sur le domaine, pas ici : sans eux, le message
# part et n'arrive pas. Voir docs/exploitation.md § Faire arriver les e-mails.
# ============================================================================

MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=REQUIRED
# Destinataire des notifications d'administration. Vide = désactivées.
MAIL_ADMIN=

# ============================================================================
# MENTIONS LÉGALES — celles de L'ORGANISATEUR, pas les tiennes : c'est lui
# l'employeur des personnes planifiées et le responsable de traitement.
# Laissées vides, la page /mentions-legales annonce elle-même qu'elle est
# incomplète, ce qu'un site ouvert au public ne peut pas se permettre.
#
# CINQ D'ENTRE ELLES FONT ÉCHOUER LE DÉMARRAGE si elles sont vides :
# LEGAL_EDITEUR, LEGAL_HEBERGEUR, LEGAL_CONTACT, LEGAL_BASE_LEGALE et
# LEGAL_CONSERVATION. Les deux autres restent facultatives — un responsable de
# traitement vide retombe sur l'éditeur, et un directeur de publication n'est
# pas exigé de tout éditeur.
# ============================================================================

# Déclare une instance qui n'est PAS en service (démonstration, recette) : la
# page peut alors rester vide et les cinq variables ci-dessous ne sont plus
# exigées. Ne pas poser ce drapeau sur une instance ouverte à ses animateurs.
LEGAL_DEMO_INSTANCE=false

LEGAL_EDITEUR=
LEGAL_DIRECTEUR_PUBLICATION=
LEGAL_HEBERGEUR=
LEGAL_CONTACT=
# Responsable de traitement au sens du RGPD, s'il diffère de l'éditeur.
LEGAL_RESPONSABLE_TRAITEMENT=
LEGAL_BASE_LEGALE=
# ATTENTION : cette durée est AFFICHÉE aux utilisateurs, et rien dans le code
# ne l'applique. La purge est manuelle et annuelle — procédure dans
# docs/exploitation.md § Conservation des données. N'annoncer que ce qui sera
# réellement tenu.
LEGAL_CONSERVATION=

# ============================================================================
# MARQUE — une instance par client. Sans ces variables, l'application s'appelle
# « Planning Équipes », n'affiche AUCUN logo plutôt que celui d'un autre
# client, et imprime ses PDF dans une palette neutre.
# ============================================================================

BRANDING_PRODUCT_NAME=
BRANDING_ORGANISATION=
BRANDING_LOGO_URL=
# Ne recolore que les feuilles de l'application, pas les composants Angular
# Material : leur palette est compilée dans le bundle. Voir README.md.
BRANDING_ACCENT_COLOR=
# Images des PDF : `classpath:/branding/xxx.png` pour une image embarquée,
# sinon un chemin de fichier monté dans le conteneur.
BRANDING_PDF_LOGO=
BRANDING_PDF_STRIP=
# Mascotte du déploiement, même syntaxe que BRANDING_LOGO_URL. La grande sert
# à l'easter egg (code Konami), la petite tourne dans la barre pendant une
# résolution et saute sur l'invite de défilement. Vides : pas d'easter egg, et
# une icône Material pendant la résolution.
BRANDING_MASCOT_URL=
BRANDING_MASCOT_ICON_URL=

# ============================================================================
# EXPLOITATION — facultatif, mais une instance sans suivi d'erreurs se
# diagnostique par téléphone.
# ============================================================================

# Suivi d'erreurs. Vide = désactivé. Voir docs/observabilite.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Glisser-déposer des affectations dans les vues Journée et Rail. Coupé par
# défaut tant que le geste est en test ; `true` pour l'offrir.
GLISSER_DEPOSER_ACTIF=false

# Adresses dont les en-têtes X-Forwarded-* sont acceptés. À renseigner dès que
# l'origine est joignable autrement que par le reverse proxy, sans quoi
# X-Forwarded-Proto reste forgeable.
TRUSTED_PROXIES=

# Adresses de vos proxys inverses telles que l'application les voit — adresses
# littérales ou blocs CIDR séparés par des virgules (172.18.0.0/16). C'est
# CETTE liste, et non TRUSTED_PROXIES, qui ferme le contournement du
# verrouillage de connexion : l'autre décide si X-Forwarded-For est lu, jamais
# quelle entrée est retenue, et Quarkus retient toujours la première — celle
# que le client a écrite.
#
# Vide, tous les appels arrivant par le proxy sont comptés sur un seul
# compteur. Le verrouillage de connexion y perd son sens ; le plafond de /mcp,
# qui compte chaque requête et non les seuls échecs, y devient hostile : un
# appelant anonyme tient le client MCP légitime en 429 à deux requêtes par
# seconde. Derrière un tunnel (Pangolin, Cloudflare Tunnel, newt), l'adresse à
# déclarer est celle du conteneur de tunnel, donc son sous-réseau :
# docker network inspect <réseau> -f '{{(index .IPAM.Config 0).Subnet}}'
# Une entrée mal formée empêche le démarrage. Voir docs/securite.md.
CONNEXION_PROXYS_FIABLES=

# Serveur MCP, premier garde : plafond de débit par adresse source sur /mcp.
# TOUTES les requêtes comptent, clé ou pas ; au-delà, la réponse est 429.
# 0 le désactive. Voir docs/mcp.md.
PLANNING_MCP_MAX_REQUESTS=120
PLANNING_MCP_RATE_WINDOW=PT1M
# Vide, /mcp compte sur CONNEXION_PROXYS_FIABLES ; à ne renseigner que pour lui
# donner une liste de proxys à lui.
PLANNING_MCP_TRUSTED_PROXIES=

# Serveur MCP, second garde : au-delà de MAX_FAILURES clés REFUSÉES consécutives,
# l'adresse reçoit 429 pendant LOCKOUT_DURATION, bonne clé comprise — sinon il
# suffirait d'attendre son tour. Le plafond de débit borne le rythme, celui-ci
# fait qu'essayer des clés coûte du temps. Une requête sans clé ne compte pas
# (un client pas encore configuré ne se verrouille donc pas), et une requête qui
# s'authentifie efface la série. 0 ou moins désactive le verrou.
PLANNING_MCP_MAX_FAILURES=5
PLANNING_MCP_LOCKOUT_DURATION=PT10M

# Fuseau du conteneur applicatif et de PostgreSQL, Europe/Paris si absent
# (docker-compose.prod.yml). C'est lui qui décide à quelle heure « aujourd'hui »
# devient « demain » : le passé figé pendant l'événement, l'ouverture et la
# clôture de la collecte de disponibilités et de la foire aux échanges, l'heure
# imprimée sur les PDF, la date des fichiers exportés. Le fuseau de l'événement,
# donc : en UTC, tout cela basculerait une ou deux heures après minuit. Les deux
# tâches de nuit se règlent à part (BACKUP_TIMEZONE, NOTIFICATIONS_TIMEZONE).
TZ=Europe/Paris

# Sauvegarde automatique : chaque nuit à 4 h, un pg_dump complet de la base
# est écrit dans BACKUP_DIR, et seules les BACKUP_RETENTION copies les plus
# récentes sont conservées. Vider BACKUP_DIR désactive la fonctionnalité : rien
# n'est planifié, et l'écran Paramètres le dit.
#
# /backups, l'ancien chemin, reste accepté (l'image en fait un lien vers
# /backup) : un .env.prod d'avant ce changement continue de sauvegarder.
#
# Le répertoire doit être accessible en écriture à l'uid 1000 (l'utilisateur du
# conteneur). Dans docker-compose.prod.yml c'est ./backup, à côté du fichier
# compose (`mkdir -p backup && sudo chown 1000:1000 backup` avant le premier
# démarrage), ce qui suffit à survivre au conteneur mais PAS à la machine : ces fichiers portent des
# données personnelles de mineurs, ils se recopient hors de l'hôte et se
# chiffrent au repos. La restauration reste une opération manuelle sur la base
# (`pg_restore`) — voir docs/exploitation.md.
BACKUP_DIR=/backup
# Entre 1 et 30. Hors de ces bornes, l'application refuse de démarrer plutôt
# que de rogner la valeur en silence.
BACKUP_RETENTION=10
# Fuseau dans lequel « 4 h » se lit — le nom du fichier aussi. Indépendant de TZ,
# qui ne s'applique pas à cette planification.
BACKUP_TIMEZONE=Europe/Paris

# Temps de calcul du solveur. Chaque édition règle son budget sur l'écran
# Solveur, mais le solveur est unique pour toute l'instance, un calcul à la
# fois : ces deux plafonds bornent ce qu'une édition peut régler ou demander,
# en secondes. Au-dessus, la valeur est refusée, jamais rognée. Le démarrage
# est refusé si un plafond est inférieur au défaut (900 s de calcul, 300 s
# d'arrêt sans amélioration). Le second vaut le premier s'il est absent.
SOLVER_SECONDS_LIMIT_MAX=3600
# SOLVER_UNIMPROVED_SECONDS_LIMIT_MAX=3600

# Envois automatiques de nuit : rappel de la veille, relance des animateurs qui
# n'ont pas accusé réception de leur planning, alerte sur les demandes d'échange
# qui dorment.
#
# Le cron est HORAIRE, et c'est voulu : l'heure d'envoi du rappel se règle par
# édition sur l'écran Paramètres, or une tâche unique ne peut pas partir à
# quatre heures différentes pour quatre éditions. Chaque envoi est réservé en
# base avant de partir, donc se réveiller douze fois n'écrit à personne deux
# fois.
#
# ATTENTION : ces deux valeurs ne suffisent PAS à faire partir quoi que ce soit.
# Chaque édition doit être armée explicitement sur l'écran Paramètres — sans
# quoi rien ne part, ce qui est le défaut et le garde-fou contre un rappel
# envoyé aux bénévoles de l'édition précédente.
NOTIFICATIONS_CRON=0 5 * * * ?
# Fuseau dans lequel se lit l'heure réglée sur l'écran. Indépendant de TZ.
NOTIFICATIONS_TIMEZONE=Europe/Paris

# Le passé est figé (docs/decisions/0044-le-passe-est-fige.md) : pendant
# l'événement, toute résolution reprend du plan enregistré les places des
# créneaux déjà commencés et les fige. `false` rend au solveur le droit de
# réécrire les journées travaillées — pour une recette qui rejoue une édition
# ancienne, jamais en production.
PASSE_FIGE=true

# Serveur MCP. Vide = inutilisable, ce qui est le bon défaut tant que personne
# ne s'en sert. Voir docs/mcp.md.
PLANNING_MCP_API_KEY=

# Répare la table d'historique Flyway au démarrage. À passer à `true`
# TEMPORAIREMENT, quand une migration interrompue en cours de route bloque
# toutes les suivantes — puis à repasser à `false`. Voir docs/exploitation.md.
FLYWAY_REPAIR_AT_START=false
