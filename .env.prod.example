# Environnement d'un déploiement de production.
#
#   cp .env.prod.example .env.prod   puis remplir, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Ne jamais committer le .env.prod rempli : il porte des secrets.
# Le mode d'emploi complet est dans docs/exploitation.md.

# ============================================================================
# OBLIGATOIRE — le démarrage échoue si l'une manque. C'est voulu : mieux vaut
# un refus de démarrer qu'un identifiant de développement en production.
# ============================================================================

# Mot de passe PostgreSQL, propre à ce déploiement.
DB_PASSWORD=

# Compte administrateur unique de l'application. Long, et propre à ce
# déploiement : il n'y a pas de second compte pour rattraper celui-ci.
ADMIN_PASSWORD=

# Clé de chiffrement des sessions admin, 16 caractères minimum. Sans clé fixe,
# toutes les sessions sont invalidées à chaque redémarrage.
SESSION_ENCRYPTION_KEY=

# URL publique, telle qu'un animateur la verra. Elle est IMPRIMÉE sur les PDF
# comme lien « espace animateur » : elle doit rester joignable après le
# festival, pas seulement pendant.
PUBLIC_URL=https://planning.example.org

# Serveur SMTP réel. L'espace animateur ne s'ouvre pas sans lui : c'est par là
# que partent les codes d'accès.
MAIL_HOST=
MAIL_FROM=planning@example.org

# ============================================================================
# COURRIER — le point le plus facile à rater, parce qu'il échoue en SILENCE.
# Un lien classé en indésirable ne produit ni erreur ni alerte.
# SPF, DKIM et DMARC se règlent sur le domaine, pas ici : sans eux, le message
# part et n'arrive pas. Voir docs/exploitation.md § Faire arriver les e-mails.
# ============================================================================

MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=REQUIRED
# Destinataire des notifications d'administration. Vide = désactivées.
MAIL_ADMIN=

# ============================================================================
# MENTIONS LÉGALES — celles de L'ORGANISATEUR, pas les tiennes : c'est lui
# l'employeur des personnes planifiées et le responsable de traitement.
# Laissées vides, la page /mentions-legales annonce elle-même qu'elle est
# incomplète, ce qu'un site ouvert au public ne peut pas se permettre.
# ============================================================================

LEGAL_EDITEUR=
LEGAL_DIRECTEUR_PUBLICATION=
LEGAL_HEBERGEUR=
LEGAL_CONTACT=
# Responsable de traitement au sens du RGPD, s'il diffère de l'éditeur.
LEGAL_RESPONSABLE_TRAITEMENT=
LEGAL_BASE_LEGALE=
# ATTENTION : cette durée est AFFICHÉE aux utilisateurs, et rien dans le code
# ne l'applique. La purge est manuelle et annuelle — procédure dans
# docs/exploitation.md § Conservation des données. N'annoncer que ce qui sera
# réellement tenu.
LEGAL_CONSERVATION=

# ============================================================================
# MARQUE — une instance par client. Sans ces variables, l'application s'appelle
# « Planning Équipes », n'affiche AUCUN logo plutôt que celui d'un autre
# client, et imprime ses PDF dans une palette neutre.
# ============================================================================

BRANDING_PRODUCT_NAME=
BRANDING_ORGANISATION=
BRANDING_LOGO_URL=
# Ne recolore que les feuilles de l'application, pas les composants Angular
# Material : leur palette est compilée dans le bundle. Voir README.md.
BRANDING_ACCENT_COLOR=
# Images des PDF : `classpath:/branding/xxx.png` pour une image embarquée,
# sinon un chemin de fichier monté dans le conteneur.
BRANDING_PDF_LOGO=
BRANDING_PDF_STRIP=

# ============================================================================
# EXPLOITATION — facultatif, mais une instance sans suivi d'erreurs se
# diagnostique par téléphone.
# ============================================================================

# Suivi d'erreurs. Vide = désactivé. Voir docs/observabilite.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Adresses dont les en-têtes X-Forwarded-* sont acceptés. À renseigner dès que
# l'origine est joignable autrement que par le reverse proxy — sinon le
# verrouillage de connexion se contourne en changeant d'adresse annoncée.
TRUSTED_PROXIES=

# Serveur MCP. Vide = inutilisable, ce qui est le bon défaut tant que personne
# ne s'en sert. Voir docs/mcp.md.
PLANNING_MCP_API_KEY=

# Répare la table d'historique Flyway au démarrage. À passer à `true`
# TEMPORAIREMENT, quand une migration interrompue en cours de route bloque
# toutes les suivantes — puis à repasser à `false`. Voir docs/exploitation.md.
FLYWAY_REPAIR_AT_START=false
