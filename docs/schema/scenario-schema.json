{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "AnimateurDto" : {
      "type" : "object",
      "properties" : {
        "competences" : {
          "$ref" : "#/$defs/Map(String,NiveauCompetence)"
        },
        "dateNaissance" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "email" : {
          "type" : "string",
          "format" : "email"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "joursIndisponibles" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/LocalDate"
          }
        },
        "manager" : {
          "type" : "boolean"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "prenom" : {
          "type" : "string",
          "minLength" : 1
        },
        "souhaits" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "competences", "dateNaissance", "id", "nom", "prenom" ]
    },
    "CreneauDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "jour" : {
          "type" : "integer",
          "format" : "int32"
        }
      },
      "required" : [ "date", "heureDebut", "heureFin", "id" ]
    },
    "DayOfWeek" : {
      "type" : "string",
      "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
    },
    "DecoupageAutoDto" : {
      "type" : "object",
      "properties" : {
        "groupeCibleNom" : {
          "type" : "string"
        },
        "groupeSourceNom" : {
          "type" : "string"
        }
      }
    },
    "EditionCibleDto" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "nom" : {
          "type" : "string"
        }
      },
      "required" : [ "id" ]
    },
    "EmplacementDto" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "latitude" : {
          "type" : "number",
          "format" : "double"
        },
        "longitude" : {
          "type" : "number",
          "format" : "double"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "id", "nom" ]
    },
    "FenetreHoraireDto" : {
      "type" : "object",
      "properties" : {
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "heureDebut" ]
    },
    "FestivalDto" : {
      "type" : "object",
      "properties" : {
        "dateDebut" : {
          "$ref" : "#/$defs/LocalDate"
        }
      },
      "required" : [ "dateDebut" ]
    },
    "HoraireStandDto" : {
      "type" : "object",
      "properties" : {
        "dateDebut" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "dateFin" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "dates" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/LocalDate"
          }
        },
        "fenetres" : {
          "minItems" : 1,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/FenetreHoraireDto"
          }
        },
        "jours" : {
          "$ref" : "#/$defs/TypeJoursHoraire"
        },
        "joursSemaine" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/DayOfWeek"
          }
        },
        "mode" : {
          "$ref" : "#/$defs/ModeHoraire"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "fenetres", "mode" ]
    },
    "IndisponibiliteStandDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "date", "heureDebut" ]
    },
    "LocalDate" : {
      "type" : "string",
      "format" : "date"
    },
    "LocalTime" : {
      "type" : "string",
      "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
    },
    "Map(String,NiveauCompetence)" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/NiveauCompetence"
      }
    },
    "ModeHoraire" : {
      "type" : "string",
      "enum" : [ "OUVERTURE", "FERMETURE" ]
    },
    "NiveauCompetence" : {
      "type" : "string",
      "enum" : [ "DEBUTANT", "AUTONOME", "REFERENT" ]
    },
    "NiveauEffort" : {
      "type" : "string",
      "enum" : [ "NORMAL", "EPUISANT" ]
    },
    "OuvertureStandDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "date", "heureDebut" ]
    },
    "ParametresDecoupageDto" : {
      "type" : "object",
      "properties" : {
        "dureeChevauchementMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "dureeDecalageMaxMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "dureePauseRepasMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "dureeVacationCibleMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "dureeVacationMaxMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "dureeVacationMinMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "fenetreRepasMidiDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fenetreRepasMidiFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fenetreRepasSoirDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fenetreRepasSoirFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "nombreFamillesDecalage" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "strategieCouverturePendantPause" : {
          "$ref" : "#/$defs/StrategieCouverturePendantPause"
        }
      }
    },
    "ParametresLegauxDto" : {
      "type" : "object",
      "properties" : {
        "dureeHebdomadaireMaxMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "pauseMinimaleEntreVacationsMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "reposQuotidienMinimalMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        }
      }
    },
    "ParametresSolveurDto" : {
      "type" : "object",
      "properties" : {
        "dureeResolutionSecondes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        }
      }
    },
    "PosteDto" : {
      "type" : "object",
      "properties" : {
        "animateurId" : {
          "type" : "string"
        },
        "creneauId" : {
          "type" : "string",
          "minLength" : 1
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "standId" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "creneauId", "id", "standId" ]
    },
    "StandDto" : {
      "type" : "object",
      "properties" : {
        "effectifMax" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "effectifMin" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "emplacementId" : {
          "type" : "string"
        },
        "horaires" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/HoraireStandDto"
          }
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "indisponibilites" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/IndisponibiliteStandDto"
          }
        },
        "niveauEffort" : {
          "$ref" : "#/$defs/NiveauEffort"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "ouvertures" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/OuvertureStandDto"
          }
        },
        "premium" : {
          "type" : "boolean"
        },
        "reserveMajeurs" : {
          "type" : "boolean"
        },
        "typologiesProposees" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "id", "nom", "typologiesProposees" ]
    },
    "StrategieCouverturePendantPause" : {
      "type" : "string",
      "enum" : [ "FERMETURE", "RELEVE", "EFFECTIF_REDUIT" ]
    },
    "TypeJoursHoraire" : {
      "type" : "string",
      "enum" : [ "TOUS", "JOURS_SEMAINE", "PLAGE", "DATES" ]
    },
    "TypologieDto" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "label" : {
          "type" : "string",
          "minLength" : 1
        },
        "ninja" : {
          "type" : "boolean"
        }
      },
      "required" : [ "id", "label" ]
    }
  },
  "type" : "object",
  "properties" : {
    "animateurs" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/AnimateurDto"
      }
    },
    "creneaux" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/CreneauDto"
      }
    },
    "decoupageAuto" : {
      "$ref" : "#/$defs/DecoupageAutoDto"
    },
    "edition" : {
      "$ref" : "#/$defs/EditionCibleDto"
    },
    "emplacements" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/EmplacementDto"
      }
    },
    "festival" : {
      "$ref" : "#/$defs/FestivalDto"
    },
    "parametresDecoupage" : {
      "$ref" : "#/$defs/ParametresDecoupageDto"
    },
    "parametresLegaux" : {
      "$ref" : "#/$defs/ParametresLegauxDto"
    },
    "parametresSolveur" : {
      "$ref" : "#/$defs/ParametresSolveurDto"
    },
    "postes" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/PosteDto"
      }
    },
    "stands" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/StandDto"
      }
    },
    "typologies" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/TypologieDto"
      }
    }
  },
  "required" : [ "animateurs", "creneaux", "festival", "stands" ]
}
