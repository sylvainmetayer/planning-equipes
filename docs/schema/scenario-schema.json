{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "AnimateurDto" : {
      "type" : "object",
      "properties" : {
        "competences" : {
          "$ref" : "#/$defs/Map(String,NiveauCompetence)"
        },
        "dateNaissance" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "email" : {
          "type" : "string",
          "format" : "email"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "joursIndisponibles" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/LocalDate"
          }
        },
        "manager" : {
          "type" : "boolean"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "prenom" : {
          "type" : "string",
          "minLength" : 1
        },
        "souhaits" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "competences", "dateNaissance", "id", "nom", "prenom" ]
    },
    "ConsigneDto" : {
      "type" : "object",
      "properties" : {
        "creneauxAjoutes" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/CreneauAjouteDto"
          }
        },
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "fenetres" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/FenetreConsigneDto"
          }
        },
        "fermetureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fermetureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "motif" : {
          "type" : "string",
          "minLength" : 1
        },
        "ouvertures" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/OuvertureConsigneDto"
          }
        },
        "prereglage" : {
          "type" : "string"
        },
        "repas" : {
          "$ref" : "#/$defs/RepasConsigneDto"
        }
      },
      "required" : [ "date", "fermetureDebut", "motif" ]
    },
    "ContrainteAdHocDto" : {
      "type" : "object",
      "properties" : {
        "animateurs" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "creneauId" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "raison" : {
          "type" : "string"
        },
        "standId" : {
          "type" : "string"
        },
        "type" : {
          "$ref" : "#/$defs/TypeContrainteAdHoc"
        }
      },
      "required" : [ "id", "type" ]
    },
    "ContraintesDto" : {
      "type" : "object",
      "properties" : {
        "activees" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "desactivees" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "poids" : {
          "$ref" : "#/$defs/Map(String,Integer)",
          "additionalProperties" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1,
            "maximum" : 100
          }
        }
      }
    },
    "CreneauAjouteDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "date", "heureDebut", "heureFin" ]
    },
    "CreneauDto" : {
      "type" : "object",
      "properties" : {
        "couverturePause" : {
          "type" : "boolean"
        },
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "jour" : {
          "type" : "integer",
          "format" : "int32"
        }
      },
      "required" : [ "date", "heureDebut", "heureFin", "id" ]
    },
    "DayOfWeek" : {
      "type" : "string",
      "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
    },
    "EditionCibleDto" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "nom" : {
          "type" : "string"
        }
      },
      "required" : [ "id" ]
    },
    "EmplacementDto" : {
      "type" : "object",
      "properties" : {
        "code" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "latitude" : {
          "type" : "number",
          "format" : "double"
        },
        "longitude" : {
          "type" : "number",
          "format" : "double"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "id", "nom" ]
    },
    "FenetreConsigneDto" : {
      "type" : "object",
      "properties" : {
        "debut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "debut" ]
    },
    "FenetreHoraireDto" : {
      "type" : "object",
      "properties" : {
        "effectif" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "heureDebut" ]
    },
    "FestivalDto" : {
      "type" : "object",
      "properties" : {
        "dateDebut" : {
          "$ref" : "#/$defs/LocalDate"
        }
      },
      "required" : [ "dateDebut" ]
    },
    "HoraireStandDto" : {
      "type" : "object",
      "properties" : {
        "dateDebut" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "dateFin" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "dates" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/LocalDate"
          }
        },
        "fenetres" : {
          "minItems" : 1,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/FenetreHoraireDto"
          }
        },
        "jours" : {
          "$ref" : "#/$defs/TypeJoursHoraire"
        },
        "joursSemaine" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/DayOfWeek"
          }
        },
        "mode" : {
          "$ref" : "#/$defs/ModeHoraire"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "fenetres", "mode" ]
    },
    "IndisponibiliteStandDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "date", "heureDebut" ]
    },
    "JourneeTypeDto" : {
      "type" : "object",
      "properties" : {
        "dates" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/LocalDate"
          }
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "vacations" : {
          "minItems" : 1,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/VacationTypeDto"
          }
        }
      },
      "required" : [ "nom", "vacations" ]
    },
    "LocalDate" : {
      "type" : "string",
      "format" : "date"
    },
    "LocalTime" : {
      "type" : "string",
      "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
    },
    "Map(String,Integer)" : {
      "type" : "object",
      "additionalProperties" : {
        "type" : "integer",
        "format" : "int32"
      }
    },
    "Map(String,NiveauCompetence)" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/NiveauCompetence"
      }
    },
    "ModeHoraire" : {
      "type" : "string",
      "enum" : [ "OUVERTURE", "FERMETURE" ]
    },
    "NiveauCompetence" : {
      "type" : "string",
      "enum" : [ "DEBUTANT", "AUTONOME", "REFERENT" ]
    },
    "NiveauEffort" : {
      "type" : "string",
      "enum" : [ "NORMAL", "EPUISANT" ]
    },
    "OuvertureConsigneDto" : {
      "type" : "object",
      "properties" : {
        "debut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "effectif" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "fin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "standId" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "debut", "standId" ]
    },
    "OuvertureStandDto" : {
      "type" : "object",
      "properties" : {
        "date" : {
          "$ref" : "#/$defs/LocalDate"
        },
        "effectif" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "motif" : {
          "type" : "string"
        }
      },
      "required" : [ "date", "heureDebut" ]
    },
    "ParametresLegauxDto" : {
      "type" : "object",
      "properties" : {
        "coupureRepasMidiDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "coupureRepasMidiFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "coupureRepasMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "coupureRepasSoirDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "coupureRepasSoirFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "dureeHebdomadaireMaxMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "dureePauseMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "dureeVacationMaxMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "heureDebutSoiree" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "reposQuotidienMinimalMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        }
      }
    },
    "ParametresQualiteDto" : {
      "type" : "object",
      "properties" : {
        "heureServiceMatinal" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureServiceTardif" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "joursConsecutifsMax" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "maxEmplacementsDistinctsParJour" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "reposSouhaiteApresServiceTardifMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "typologiesDistinctesMax" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        }
      }
    },
    "ParametresSolveurDto" : {
      "type" : "object",
      "properties" : {
        "dureeResolutionSecondes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        }
      }
    },
    "PosteDto" : {
      "type" : "object",
      "properties" : {
        "animateurId" : {
          "type" : "string"
        },
        "creneauId" : {
          "type" : "string",
          "minLength" : 1
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "standId" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "creneauId", "id", "standId" ]
    },
    "PrereglageConsigneDto" : {
      "type" : "object",
      "properties" : {
        "fenetres" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/FenetreConsigneDto"
          }
        },
        "fermetureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "fermetureFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "id" : {
          "type" : "string"
        },
        "motif" : {
          "type" : "string",
          "minLength" : 1
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "repas" : {
          "$ref" : "#/$defs/RepasConsigneDto"
        }
      },
      "required" : [ "fermetureDebut", "motif", "nom" ]
    },
    "RepasConsigneDto" : {
      "type" : "object",
      "properties" : {
        "coupureMinutes" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "justification" : {
          "type" : "string",
          "minLength" : 1
        },
        "midiDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "midiFin" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "soirDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "soirFin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "justification" ]
    },
    "StandDto" : {
      "type" : "object",
      "properties" : {
        "effectifMax" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "effectifMin" : {
          "type" : "integer",
          "format" : "int32",
          "minimum" : 0
        },
        "emplacementId" : {
          "type" : "string"
        },
        "horaires" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/HoraireStandDto"
          }
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "indisponibilites" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/IndisponibiliteStandDto"
          }
        },
        "niveauEffort" : {
          "$ref" : "#/$defs/NiveauEffort"
        },
        "nom" : {
          "type" : "string",
          "minLength" : 1
        },
        "ouvertures" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/OuvertureStandDto"
          }
        },
        "premium" : {
          "type" : "boolean"
        },
        "reserveMajeurs" : {
          "type" : "boolean"
        },
        "typologiesProposees" : {
          "minItems" : 1,
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "effectifMax", "effectifMin", "id", "nom", "typologiesProposees" ]
    },
    "TypeContrainteAdHoc" : {
      "type" : "string",
      "enum" : [ "INDISPONIBILITE_FORCEE", "INCOMPATIBILITE", "AFFECTATION_FORCEE", "AFFINITE" ]
    },
    "TypeJoursHoraire" : {
      "type" : "string",
      "enum" : [ "TOUS", "JOURS_SEMAINE", "PLAGE", "DATES" ]
    },
    "TypologieDto" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string",
          "minLength" : 1
        },
        "label" : {
          "type" : "string",
          "minLength" : 1
        },
        "maxCreneauxParAnimateur" : {
          "type" : "integer",
          "format" : "int32",
          "exclusiveMinimum" : 0
        },
        "ninja" : {
          "type" : "boolean"
        }
      },
      "required" : [ "id", "label" ]
    },
    "VacationTypeDto" : {
      "type" : "object",
      "properties" : {
        "couverturePause" : {
          "type" : "boolean"
        },
        "heureDebut" : {
          "$ref" : "#/$defs/LocalTime"
        },
        "heureFin" : {
          "$ref" : "#/$defs/LocalTime"
        }
      },
      "required" : [ "heureDebut", "heureFin" ]
    }
  },
  "type" : "object",
  "properties" : {
    "animateurs" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/AnimateurDto"
      }
    },
    "consignes" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/ConsigneDto"
      }
    },
    "contraintes" : {
      "$ref" : "#/$defs/ContraintesDto"
    },
    "contraintesAdHoc" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/ContrainteAdHocDto"
      }
    },
    "creneaux" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/CreneauDto"
      }
    },
    "edition" : {
      "$ref" : "#/$defs/EditionCibleDto"
    },
    "emplacements" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/EmplacementDto"
      }
    },
    "festival" : {
      "$ref" : "#/$defs/FestivalDto"
    },
    "journeesTypes" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/JourneeTypeDto"
      }
    },
    "parametresLegaux" : {
      "$ref" : "#/$defs/ParametresLegauxDto"
    },
    "parametresQualite" : {
      "$ref" : "#/$defs/ParametresQualiteDto"
    },
    "parametresSolveur" : {
      "$ref" : "#/$defs/ParametresSolveurDto"
    },
    "postes" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/PosteDto"
      }
    },
    "prereglagesConsigne" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/PrereglageConsigneDto"
      }
    },
    "stands" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/StandDto"
      }
    },
    "typologies" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/TypologieDto"
      }
    }
  },
  "required" : [ "animateurs", "creneaux", "festival", "stands" ]
}
