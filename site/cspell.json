{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": [
    "@cspell/dict-fr-fr/cspell-ext.json"
  ],
  "language": "fr,en",
  "files": [
    "src/_data/pages/*.json",
    "src/_data/articles.js",
    "src/docs/index.md",
    "src/docs/regles/*.md",
    "src/docs/installer/*.md",
    "src/docs/comprendre/*.md",
    "src/docs-en/index.md",
    "src/docs-en/*/*.md"
  ],
  "ignoreRegExpList": [
    "/\"[A-Za-z0-9_-]+\"\\s*:/g",
    "/\\]\\([^)]*\\)/g",
    "/https?:\\/\\/\\S+/g",
    "/\\b[LRD]\\d{4}-\\d+\\b/g",
    "/(fr|en): \\{/g",
    "/\\b(?:number|subject|rule)\\b:/g",
    "/^---\\n[\\s\\S]*?\\n---\\n/",
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]*`/g",
    "/\\(\\/images\\/[^)]*\\)/g"
  ],
  "overrides": [
    {
      "filename": "src/docs-en/**",
      "language": "en-GB",
      "ignoreRegExpList": [
        "/\"[^\"\\n]+\"(?=,? \\()/g",
        "/\\(\"[^\"\\n]+\",/g",
        "/; \"[^\"\\n]+\",/g",
        "/\\*\\*[^*\\n]+\\*\\*(?= \\()/g"
      ]
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "site-words",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "site-words"
  ]
}
