---
layout: base.njk
pagination:
  data: docs
  size: 1
  alias: p
permalink: "{{ p.url }}index.html"
eleventyExcludeFromCollections: true
eleventyComputed:
  lang: "fr"
  key: "docs"
  altLang: "en"
  canonical: "{{ p.url }}"
  title: "{{ p.title }}"
  description: "{{ p.description }}"
  ogTitle: "{{ p.h1 }}"
  ogAlt: "{{ copy.fr.accueil.ogTitre }}"
---
{% set c = copy.fr.docs %}
<article class="doc" data-player="2">
  <header class="ask">
    <div class="container">
      <nav class="crumbs" aria-label="{{ copy.fr.commun.ariane }}"><ol><li><a href="{{ urls.fr.accueil }}">{{ copy.fr.commun.nav.accueil }}</a></li>{% if p.name == 'README' %}<li aria-current="page">{{ c.h1 }}</li>{% else %}<li><a href="/docs/">{{ c.h1 }}</a></li><li aria-current="page">{{ p.h1 | typo('fr') }}</li>{% endif %}</ol></nav>
      <h1>{{ (c.h1 if p.name == 'README' else p.h1) | typo('fr') }}</h1>
    </div>
  </header>
  <div class="container doc__grid">
    <div class="doc__side">
      {% if p.toc.length %}
      <nav class="doc__nav" aria-labelledby="doc-toc"><details data-open-wide><summary class="doc__label" id="doc-toc">{{ c.surCettePage }}</summary>
        <ul>{% for h in p.toc %}<li class="doc__l{{ h.level }}"><a href="#{{ h.id }}">{{ h.text | typo('fr') }}</a></li>{% endfor %}</ul>
      </details></nav>
      {% endif %}
      <nav class="doc__nav" aria-labelledby="doc-all"><details data-open-wide><summary class="doc__label" id="doc-all">{{ c.rubriques }}</summary>
        <ul><li><a href="/docs/"{% if p.name == 'README' %} aria-current="page"{% endif %}>{{ c.accueil | typo('fr') }}</a></li>
        {% for part in docsParts %}<li><span class="doc__part">{{ part.titre }}</span>
          <ul>{% for n in part.docs %}{% set d = docs | byName(n) %}<li><a href="{{ d.url }}"{% if d.url == p.url %} aria-current="page"{% endif %}>{{ d.h1 | typo('fr') }}</a></li>{% endfor %}</ul></li>{% endfor %}</ul>
      </details></nav>
    </div>
    <div class="doc__main">{{ p.body | safe }}</div>
  </div>
  <aside class="container related" aria-labelledby="voir-t">
    <h2 id="voir-t">{{ copy.fr.commun.voirAussi }}</h2>
    <ul>
      <li><a href="{{ urls.fr.hebergement }}">{{ copy.fr.hebergement.h1 | typo('fr') }}</a></li>
      <li><a href="{{ urls.fr.accueil }}">{{ copy.fr.commun.nav.accueil }}</a></li>
    </ul>
  </aside>
</article>
