# Headers served by Cloudflare Pages (ignored elsewhere).
# CSP: the page has no inline script or style of its own (its scripts,
# popin.js, theme.js, contact.js: screenshots, theme switch, form height), and its fonts are
# its own (self-hosted, @fontsource); only the Cloudflare Web Analytics beacon
# comes from elsewhere, and it reports to cloudflareinsights.com. connect-src also
# allows the site itself: Lighthouse fetches robots.txt from the page and a CSP
# without it fails the audit. The contact page frames its Tally form, the one
# frame-src (a plain iframe, no Tally script). form-action 'self': the search
# form of the site map submits ?q= to its own page.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; media-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'self'; frame-src https://tally.so; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Captures and videos weigh the most and rarely change; no hash in their names,
# so a replaced one can stay stale for a day.
/images/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400

# Fonts: names without a hash, long but not immutable, like ref.sylvain.dev.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

