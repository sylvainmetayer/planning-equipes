{% from "film.njk" import film %}
{% set c = copy[lang].accueil %}
{% set labels = c.images.filmsLabels %}
{% set mail = urls[lang].contact %}
{% set ticket = c.loi.refus[0] %}

<section class="hero" aria-labelledby="titre">
  <div class="container hero__in">
    <div class="hero__say">
      <h1 id="titre">{{ c.h1 | typo(lang) }}</h1>
      <p class="lead">{{ c.lede | typo(lang) }}</p>
      <p class="acts">
        <a class="btn btn--primary" href="{{ urls[lang].demo }}">{{ c.cta }}</a>
        <a class="btn" href="{{ site.repo }}">{{ c.cta2 }}</a>
      </p>
    </div>
    <figure class="hero__shot">
      <a class="shot" href="/images/{{ lang }}/planning.webp" data-popin="hero" data-caption="{{ c.heroLegende | typo(lang) }}">
        <img src="/images/{{ lang }}/planning.webp" srcset="/images/{{ lang }}/vignettes/planning.webp 800w, /images/{{ lang }}/planning.webp 1440w" sizes="(min-width: 60rem) 56vw, 100vw" width="1440" height="900" fetchpriority="high" alt="{{ c.heroAlt }}">
      </a>
      <div class="rule-card" role="note" aria-label="{{ c.ticketTitre }}, {{ ticket.article }}">
        <p class="rule-card__top"><span>{{ c.ticketTitre }}</span><span class="rule-card__art">{{ ticket.article }}</span></p>
        <p>{{ (ticket.qui + ', ' + ticket.poste + (' : ' if lang == 'fr' else ': ') + ticket.raison + '.') | typo(lang) }}</p>
      </div>
      <figcaption class="caption">{{ c.heroLegende | typo(lang) }}</figcaption>
    </figure>
  </div>
</section>

<section class="sec" data-player="1" id="ecrans" aria-labelledby="ecrans-t">
  <div class="container">
    <div class="head">
      <h2 id="ecrans-t">{{ c.images.h2 | typo(lang) }}</h2>
      <p class="lead">{{ c.images.intro | typo(lang) }}</p>
    </div>
    <ul class="cards">
      {% for e in c.images.ecrans %}
      <li class="card" data-player="{{ (loop.index0 % 4) + 1 }}">
        <a class="card__pic" href="/images/{{ lang }}/{{ e.id }}.webp" data-popin="ecrans" data-caption="{{ e.alt | typo(lang) }}"><img src="/images/{{ lang }}/vignettes/{{ e.id }}.webp" width="800" height="{{ 450 if e.id == 'mural' else 500 }}" loading="lazy" decoding="async" alt="{{ e.alt | typo(lang) }}"></a>
        <h3>{{ e.titre }}</h3>
        <p>{{ e.alt | after(':') | cap | typo(lang) }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="sec sec--tint" data-player="4" id="loi" aria-labelledby="loi-t">
  <div class="container">
    <div class="head">
      <h2 id="loi-t">{{ c.loi.h2 | typo(lang) }}</h2>
      <p class="lead">{{ c.loi.reponse | mdi(lang) | safe }}</p>
    </div>
    <div class="example">
      <p class="example__title">{{ c.loi.refusTitre }}</p>
      <div class="scroll" role="group" aria-label="{{ c.loi.refusTitre }}" tabindex="0">
        <table class="rows">
          <caption class="visually-hidden">{{ c.loi.refusTitre }}</caption>
          <thead><tr>{% for h in c.loi.refusColonnes %}<th scope="col"{% if loop.last %} class="end"{% endif %}>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for r in c.loi.refus %}
            <tr><th scope="row">{{ r.qui }}</th><td>{{ r.poste }}</td><td>{{ r.raison | typo(lang) }}</td><td class="art">{{ r.article }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="example__note">{{ c.loi.exemple }} {{ c.loi.mention }}</p>
    </div>
    <p class="more"><a href="{{ urls[lang].legal }}">{{ c.loi.lien }}</a></p>
  </div>
</section>

<section class="sec" data-player="2" id="calcul" aria-labelledby="cas-t">
  <div class="container pinned">
    <div class="pinned__stage">{{ film(c.images.films | byId(c.cas.film), lang, labels, false) }}</div>
    <div class="pinned__panels">
      <h2 id="cas-t">{{ c.cas.h2 | typo(lang) }}</h2>
      <p class="lead">{{ c.cas.intro | typo(lang) }}</p>
      <ol class="levels">
        {% for n in c.cas.niveaux %}<li data-player="{{ loop.index }}"><h3>{{ n.titre | typo(lang) }}</h3><p>{{ n.texte | typo(lang) }}</p></li>{% endfor %}
      </ol>
      <p class="more"><a href="{{ urls[lang].calcul }}">{{ c.cas.lien }}</a></p>
    </div>
  </div>
</section>

<section class="sec sec--tint" data-player="3" id="equipes" aria-labelledby="e-titre">
  <div class="container bento">
    <div class="bento__phone">{{ film(c.images.films | byId(c.equipes.film), lang, labels, true) }}</div>
    <div class="bento__head">
      <h2 id="e-titre">{{ c.equipes.h2 | typo(lang) }}</h2>
      <p class="lead">{{ c.equipes.texte | mdi(lang) | safe }}</p>
    </div>
    <ul class="tiles">
      {% for t in c.equipes.tuiles %}<li class="card card--text" data-player="{{ loop.index }}"><h3>{{ t.titre | typo(lang) }}</h3><p>{{ t.texte | typo(lang) }}</p></li>{% endfor %}
    </ul>
    <div class="bento__foot">
      <p>{{ c.equipes.outils | typo(lang) }}</p>
      <p class="more"><a href="{{ urls[lang].equipe }}">{{ c.equipes.lien }}</a></p>
      <p>{{ c.equipes.exemples.intro | typo(lang) }}</p>
      <ul class="exemples">
        {% for e in c.equipes.exemples.liens %}<li><a href="/exemples/{{ e.fichier }}">{{ e.texte | typo(lang) }}</a> ({{ e.pages }}, {{ ('/exemples/' + e.fichier) | weight(labels.unite) | typo(lang) }})</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="sec" data-player="1" id="jour-j" aria-labelledby="j-titre">
  <div class="container">
    <div class="head">
      <h2 id="j-titre">{{ c.jourj.h2 | typo(lang) }}</h2>
      <p class="lead">{{ c.jourj.intro | typo(lang) }}</p>
    </div>
    <div class="show">
      {{ film(c.images.films | byId(c.jourj.film), lang, labels, false) }}
      <ul class="facts">{% for p in c.jourj.points %}<li data-player="{{ loop.index + 1 }}">{{ p | typo(lang) }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="sec sec--tint" data-player="3" id="evenements" aria-labelledby="ev-t">
  <div class="container related">
    <h2 id="ev-t">{{ c.types.h2 | typo(lang) }}</h2>
    <p class="lead">{{ c.types.intro | typo(lang) }}</p>
    <ul>
      {% for k in ['festival', 'salon', 'sport', 'tableur', 'mineurs'] %}<li><a href="{{ urls[lang][k] }}">{{ copy[lang][k].h1 | typo(lang) }}</a></li>{% endfor %}
    </ul>
  </div>
</section>

<section class="sec" data-player="2" id="questions" aria-labelledby="faq-t">
  <div class="container asks">
    <div class="asks__head">
      <h2 id="faq-t">{{ c.faq.h2 | typo(lang) }}</h2>
      <p class="more"><a href="{{ urls[lang].faq }}">{{ c.faq.toutes }}</a></p>
    </div>
    <div class="asks__list">
      {% for i in copy[lang].faq.items %}{% if i.accueil %}
      <details><summary>{{ i.q | typo(lang) }}</summary><p>{{ i.a | mdi(lang) | safe }}</p></details>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--close" data-player="4" id="contact" aria-labelledby="devis-t">
  <div class="container">
    <div class="head">
      <h2 id="devis-t">{{ c.ensemble.h2 | typo(lang) }}</h2>
      <div class="close">
        <p class="lead">{{ c.ensemble.prix | typo(lang) }}</p>
        <p class="acts"><a class="btn btn--primary" href="{{ mail }}">{{ c.ensemble.cta }}</a></p>
      </div>
    </div>
    <ol class="turns">
      {% for e in c.ensemble.etapes %}
      <li class="card card--text" data-player="{{ loop.index }}">
        <h3>{{ e.titre | typo(lang) }}</h3>
        <dl>
          <div><dt>{{ c.ensemble.vous }}</dt><dd>{{ e.vous | cap | typo(lang) }}</dd></div>
          <div><dt>{{ c.ensemble.nous }}</dt><dd>{{ e.nous | cap | typo(lang) }}</dd></div>
        </dl>
      </li>
      {% endfor %}
    </ol>
    <p class="more"><a href="{{ urls[lang].hebergement }}">{{ c.ensemble.soiMeme }}</a></p>
  </div>
</section>
