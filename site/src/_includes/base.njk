<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | typo(lang) }}</title>
<meta name="description" content="{{ description }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f8f2e6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1f1b16" media="(prefers-color-scheme: dark)">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% if canonical %}
<link rel="canonical" href="{{ site.url }}{{ canonical }}">
<link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ canonical }}">
<link rel="alternate" hreflang="{{ altLang }}" href="{{ site.url }}{{ altUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ canonical if lang == 'fr' else altUrl }}">
<link rel="alternate" type="text/markdown" href="{{ site.url }}{{ canonical }}index.md">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ (ogTitle or title) | typo(lang) }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ canonical }}">
<meta property="og:locale" content="{{ 'fr_FR' if lang == 'fr' else 'en_GB' }}">
<meta property="og:locale:alternate" content="{{ 'en_GB' if lang == 'fr' else 'fr_FR' }}">
<meta property="og:image" content="{{ site.url }}/og-{{ lang }}.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogAlt }}">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{{ p | jsonld(build.modified) | safe }}
</script>
{% endif %}
<script src="/assets/theme.js"></script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/rethink-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
{% set common = copy[lang].commun %}
<a class="skip" href="#contenu">{{ common.skip }}</a>
<header class="top">
  <div class="container top__in">
    <nav class="top__nav" aria-label="{{ common.nav.label }}">
      <ul>
        {% for k in ['tableur', 'legal', 'equipe', 'calcul', 'hebergement', 'faq'] %}
        <li><a href="{{ urls[lang][k] }}"{% if k == key %} aria-current="page"{% endif %}>{{ common.nav[k] }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <a class="mark" href="{{ urls[lang].accueil }}" aria-label="{{ common.logoLabel }}"{% if key == 'accueil' %} aria-current="page"{% endif %}>{{ site.name }}</a>
    <p class="top__acts">
      <a class="top__lang" href="{{ altUrl or urls[altLang].accueil }}" hreflang="{{ altLang }}" lang="{{ altLang }}" aria-label="{{ common.nav.langueLabel }}">{{ common.nav.langue }}</a>
      <button class="theme" type="button" data-theme-toggle data-t-auto="{{ common.theme.auto }}" data-t-clair="{{ common.theme.clair }}" data-t-sombre="{{ common.theme.sombre }}" aria-label="{{ common.theme.auto }}" hidden><svg class="theme__i theme__i--auto" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></g></svg><svg class="theme__i theme__i--clair" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg><svg class="theme__i theme__i--sombre" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></g></svg></button>
      <a class="btn btn--sm" href="{{ urls[lang].contact }}">{{ common.nav.contact }}</a>
    </p>
  </div>
</header>
<main id="contenu">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="container foot__in">
    <p class="foot__mark">{{ site.name }}</p>
    <ul class="foot__links" aria-label="{{ common.pied.liens }}">
      <li><a href="mailto:{{ site.email }}?subject={{ common.contactSujet | urlencode }}">{{ common.pied.ecrire }}</a></li>
      <li><a href="{{ site.repo }}">{{ common.pied.codeSource }}</a></li>
      <li><a href="{{ site.repo }}/releases">{{ common.pied.nouveautes }}</a></li>
      <li><a href="{{ site.repo }}/issues">{{ common.pied.probleme }}</a></li>
      <li><a href="{{ urls[lang].mentions }}">{{ common.pied.mentions }}</a></li>
    </ul>
    <div class="foot__fine">
      <p>{{ site.name }}, {{ common.pied.licence }} {{ common.pied.fictif }}</p>
      <p>{{ common.pied.editeur }}</p>
    </div>
  </div>
</footer>
<dialog class="popin" aria-label="{{ common.popin.label }}" data-popin-dialog>
  <button class="popin__close btn" type="button" data-popin-close>{{ common.popin.fermer }}</button>
  <figure class="popin__fig"><figcaption></figcaption></figure>
  <button class="popin__nav popin__nav--prev" type="button" data-popin-prev aria-label="{{ common.popin.precedente }}" hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <button class="popin__nav popin__nav--next" type="button" data-popin-next aria-label="{{ common.popin.suivante }}" hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
</dialog>
<script type="module" src="/assets/popin.js"></script>
{% if key == 'contact' %}<script defer src="/assets/contact.js"></script>{% endif %}
{% if build.analytics %}<!-- Cloudflare Web Analytics: no cookie. Token in site.json, from `tofu output -raw web_analytics_token` in homelab -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.beaconToken }}"}'></script>{% endif %}
</body>
</html>
