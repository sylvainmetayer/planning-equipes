{% set c = copy[lang][key] %}
{% set mail = urls[lang].contact %}
{% set player = {'legal': 4, 'equipe': 3, 'hebergement': 1, 'festival': 1, 'salon': 3, 'sport': 4, 'mineurs': 4}[key] or 2 %}
<article data-player="{{ player }}">
  <header class="ask">
    <div class="container">
      <h1>{{ c.h1 | typo(lang) }}</h1>
      <p class="lead">{{ c.reponse | mdi(lang) | safe }}</p>
      {% if c.bouton %}<p class="acts"><a class="btn btn--primary" href="{{ mail }}">{{ c.bouton }}</a></p>{% endif %}
    </div>
  </header>

  {% if key == 'contact' %}
  <section class="container form" aria-label="{{ c.h1 | typo(lang) }}">
    <div class="form__sheet"><iframe class="form__frame" src="https://tally.so/embed/{{ site.tally[lang] }}?alignLeft=1&amp;hideTitle=1&amp;transparentBackground=1&amp;dynamicHeight=1" title="{{ c.formTitre }}" loading="lazy"></iframe></div>
    <p class="form__alt"><a href="https://tally.so/r/{{ site.tally[lang] }}">{{ c.lien }}</a> {{ c.ecrire }} <a href="mailto:{{ site.email }}?subject={{ copy[lang].commun.contactSujet | urlencode }}">{{ site.email }}</a></p>
  </section>
  {% endif %}

  {% if key == 'legal' %}
  <section class="sec sec--tint" aria-labelledby="art-t">
    <div class="container">
      <div class="head"><h2 id="art-t">{{ c.articlesH }}</h2></div>
      <div class="example">
        <div class="scroll" role="group" aria-label="{{ c.articlesH }}" tabindex="0">
          <table class="rows rows--law">
            <thead><tr>{% for h in c.colonnes %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>
              {% for a in articles %}
              <tr id="{{ a.number }}"><th scope="row" class="art">{{ a.number }}</th><td>{{ a[lang].subject }}</td><td>{{ a[lang].rule | typo(lang) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="example__note"><a href="{{ site.legifrance }}">Légifrance</a></p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if c.sections %}
  <section class="container chapters" aria-label="{{ c.h1 | typo(lang) }}">
    {% for s in c.sections %}
    <div class="chapter" data-player="{{ ((loop.index0 + player) % 4) + 1 }}">
      <h2>{{ s.h2 | typo(lang) }}</h2>
      <div class="prose">{{ s.texte | md(lang) | safe }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if c.tableau %}
  <section class="sec sec--tint" aria-labelledby="tab-t">
    <div class="container">
      <div class="head"><h2 id="tab-t">{{ c.tableau.h2 | typo(lang) }}</h2></div>
      <div class="example">
        <div class="scroll" role="group" aria-label="{{ c.tableau.h2 | typo(lang) }}" tabindex="0">
          <table class="rows rows--cmp">
            <caption class="visually-hidden">{{ c.tableau.h2 | typo(lang) }}</caption>
            <thead><tr>{% for h in c.tableau.colonnes %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>
              {% for l in c.tableau.lignes %}
              <tr><th scope="row">{{ l.q | typo(lang) }}</th><td>{{ l.tableur | typo(lang) }}</td><td>{{ l.logiciel | typo(lang) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% if c.items %}
  <section class="container asks__list asks__list--page" aria-label="{{ c.h1 | typo(lang) }}">
    {% for i in c.items %}
    <details id="{{ i.id }}"><summary>{{ i.q | typo(lang) }}</summary><p>{{ i.a | mdi(lang) | safe }}</p></details>
    {% endfor %}
  </section>
  {% endif %}

  {% if c.cta %}
  <section class="sec sec--close" aria-labelledby="cta-t">
    <div class="container close">
      <h2 id="cta-t">{{ c.cta | typo(lang) }}</h2>
      <p class="acts"><a class="btn btn--primary" href="{{ mail }}">{{ c.bouton }}</a></p>
    </div>
  </section>
  {% endif %}

  {% if c.liens %}
  <aside class="container related" aria-labelledby="voir-t">
    <h2 id="voir-t">{{ copy[lang].commun.voirAussi }}</h2>
    <ul>
      {% for k in c.liens %}<li><a href="{{ urls[lang][k] }}">{{ copy[lang][k].h1 | typo(lang) }}</a></li>{% endfor %}
      <li><a href="{{ urls[lang].accueil }}">{{ copy[lang].commun.nav.accueil }}</a></li>
    </ul>
  </aside>
  {% endif %}
</article>
