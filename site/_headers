# Headers served by Cloudflare Pages (ignored elsewhere).
# CSP: the page has no inline script or style of its own; only the Cloudflare
# Web Analytics beacon comes from elsewhere, and it reports to
# cloudflareinsights.com.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; script-src https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Repository files published along with the folder: not to be indexed.
/README.md
  X-Robots-Tag: noindex
/wrangler.toml
  X-Robots-Tag: noindex
