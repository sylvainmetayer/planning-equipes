<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns="https://timefold.ai/xsd/solver"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://timefold.ai/xsd/solver https://timefold.ai/xsd/solver/solver.xsd">

    <!--
        Fixed seed: makes solves reproducible run-to-run, which is what let us
        diagnose the local-optimum problem below in the first place. Remove if
        solution diversity across repeated solves is ever wanted back.
    -->
    <!--
        Timefold 1.x defaults to PHASE_ASSERT, which re-runs a full score
        recalculation to check for score corruption at every phase boundary and
        keeps the intrusive bookkeeping needed to do so. REPRODUCIBLE keeps the
        fixed-seed determinism below (same seed, same plan) without paying for
        those checks. If score corruption is ever suspected, set this back to
        PHASE_ASSERT (or FULL_ASSERT to pinpoint the guilty move).

        Element order is imposed by the XSD (SolverConfig's propOrder):
        environmentMode, then randomSeed, then moveThreadCount.
    -->
    <environmentMode>REPRODUCIBLE</environmentMode>

    <randomSeed>0</randomSeed>

    <!--
        No <moveThreadCount>: multi-threaded incremental solving requires
        Timefold Solver Enterprise Edition (commercial). Measured here — the
        solver refuses to start with "Enterprise Edition could not be loaded".
        The 8 cores of the host stay unusable by the solver as a result.
    -->


    <solutionClass>dev.sylvain.planning.domain.PlanningFestival</solutionClass>
    <entityClass>dev.sylvain.planning.domain.PosteAffectation</entityClass>

    <scoreDirectorFactory>
        <constraintProviderClass>dev.sylvain.planning.solver.PlanningConstraintProvider</constraintProviderClass>
    </scoreDirectorFactory>

    <!--
        Explicit pipeline. FIRST_FIT_DECREASING builds the initial assignment,
        then Late Acceptance does the heavy lifting. A dedicated union move
        selector (change + swap) keeps a healthy move diversity so the search
        can trade an "unavailable" assignment for an available animateur
        rather than stalling. Termination (seconds / unimproved-seconds) is
        injected programmatically by PlanningService.

        FIRST_FIT_DECREASING (not FIRST_FIT): postes are processed hardest
        first, via PosteAffectationDifficultyComparatorFactory which ranks
        them by how many animateurs are actually eligible (competence +
        availability). Plain FIRST_FIT processed postes in declaration order,
        so easy postes greedily consumed animateurs that scarce postes needed
        later, regularly leaving several postes unpourvus/double-booked
        (hard violations) for local search to repair from a bad starting
        point — a major source of the run-to-run inconsistency this fixes.

        The animateurRange value range spans every animateur (~150): eligibility
        depends on the target poste, not on a static animateur property, so it
        cannot be narrowed at the @ValueRangeProvider level. EligibleAnimateurMoveFilter
        rejects moves that assign an incompetent or unavailable animateur before
        the solver pays for a score calculation, which is what keeps the full
        ~150 animateurs / 2000+ postes scenario solvable in reasonable time on
        constrained hardware (e.g. a Raspberry Pi).
    -->
    <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>
        <changeMoveSelector>
            <filterClass>dev.sylvain.planning.solver.EligibleAnimateurMoveFilter$ChangeMoveFilter</filterClass>
        </changeMoveSelector>
    </constructionHeuristic>
    <localSearch>
        <unionMoveSelector>
            <changeMoveSelector>
                <filterClass>dev.sylvain.planning.solver.EligibleAnimateurMoveFilter$ChangeMoveFilter</filterClass>
                <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
            </changeMoveSelector>
            <swapMoveSelector>
                <filterClass>dev.sylvain.planning.solver.EligibleAnimateurMoveFilter$SwapMoveFilter</filterClass>
                <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
            </swapMoveSelector>
            <!--
                Uniform Change/Swap selection over ~2000+ postes samples the
                handful still unassigned far too rarely to clear the last
                posteDoitEtrePourvu violations within the time budget (empirically:
                the solver plateaus at 1-10 unfilled seats out of 2088 even after
                the full 180s). These two selectors restrict one side of the pair
                to unassigned postes and get an equal share of move attempts
                (fixedProbabilityWeight), so filling an empty seat directly, or by
                displacing someone already scheduled elsewhere at a different
                slot, is tried constantly instead of by chance.
            -->
            <changeMoveSelector>
                <filterClass>dev.sylvain.planning.solver.EligibleAnimateurMoveFilter$ChangeMoveFilter</filterClass>
                <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
                <entitySelector>
                    <filterClass>dev.sylvain.planning.solver.UnassignedPosteFilter</filterClass>
                </entitySelector>
            </changeMoveSelector>
            <swapMoveSelector>
                <filterClass>dev.sylvain.planning.solver.EligibleAnimateurMoveFilter$SwapMoveFilter</filterClass>
                <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
                <entitySelector>
                    <filterClass>dev.sylvain.planning.solver.UnassignedPosteFilter</filterClass>
                </entitySelector>
            </swapMoveSelector>
        </unionMoveSelector>
        <acceptor>
            <lateAcceptanceSize>400</lateAcceptanceSize>
        </acceptor>
        <forager>
            <!--
                Number of candidate moves sampled per local-search step. This
                was 4, then 20 for the quality of each step on the 2088-poste
                reference scenario. Measured again on the real 3502-poste 2026
                scenario (153 animateurs, 45 premium stands), same seed, same
                180 s budget, runs executed sequentially:

                    acceptedCountLimit :  1     2     3    4    10    20    40
                    score dur a 180 s  :  0     0    -1   -3    -6   -14   -27
                    0 hard atteint a   : 95s  137s     jamais dans le budget

                The trade-off inverted with the problem size: at 3502 postes a
                step costs enough that sampling 20 candidates starves the
                search, and the setting that was "safer" never reaches
                feasibility at all — the 1800 s production run stalled at
                -2 hard while 2 gets there in under three minutes. 2 rather
                than 1: both reach feasibility on every seed tried, 1 gets
                there ~45 s earlier but with a visibly worse medium score
                (-9 211 vs -8 502 at equal time), and what follows feasibility
                is precisely medium/soft polishing.

                lateAcceptanceSize was re-measured alongside: 100 / 400 / 1500
                give -14 / -14 / -12 at acceptedCountLimit 20, and -1 / 0 / 0
                at 2. Below 400 it hurts, above it changes nothing: left as is.
            -->
            <acceptedCountLimit>2</acceptedCountLimit>
        </forager>
    </localSearch>

</solver>
