{
  "name": "planning-equipes-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-version": "node scripts/generate-version.js",
    "generate-news": "node scripts/generate-news.js",
    "generate": "npm run generate-version && npm run generate-news",
    "prestart": "npm run generate",
    "start": "ng serve",
    "prebuild": "npm run generate",
    "build": "ng build",
    "postbuild": "node scripts/check-csp-index.js",
    "prewatch": "npm run generate",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate",
    "test": "ng test",
    "pretest:coverage": "npm run generate",
    "test:coverage": "ng test --coverage --coverage-reporters lcovonly --coverage-reporters html --coverage-reporters text-summary",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css,scss}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" \"*.js\" \"*.ts\" \"*.json\"",
    "format-check": "prettier --check \"src/**/*.{ts,css,scss}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" \"*.js\" \"*.ts\" \"*.json\"",
    "i18n-check": "npm run generate && node scripts/check-i18n.js",
    "i18n-check-modifies": "npm run generate && node scripts/check-i18n.js --modifies",
    "api-types-check": "node scripts/check-api-types.js",
    "api-paths-check": "node scripts/check-api-paths.js",
    "api-contract-check": "node scripts/check-api-contract.js",
    "css-scope-check": "node scripts/check-css-scope.js",
    "icon-labels-check": "node scripts/check-icon-labels.js",
    "headings-check": "node scripts/check-headings.js",
    "status-messages-check": "node scripts/check-status-messages.js",
    "table-headers-check": "node scripts/check-table-headers.js",
    "stores-check": "node scripts/check-readonly-stores.js",
    "api-schema": "node scripts/refresh-api-schema.js",
    "licences": "node scripts/licences-tierces.js",
    "licences-check": "node scripts/licences-tierces.js --check",
    "e2e": "playwright test",
    "language-policy": "node scripts/check-language-policy.js",
    "language-policy-modifies": "node scripts/check-language-policy.js --modifies",
    "language-policy-inventaire": "node scripts/check-language-policy.js --inventaire"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@sentry/angular": "^10.69.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
