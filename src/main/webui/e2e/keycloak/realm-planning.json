{
  "realm": "planning",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "users": [
    {
      "username": "organisatrice",
      "email": "organisatrice@example.org",
      "emailVerified": true,
      "firstName": "Organisatrice",
      "lastName": "Connue",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${E2E_OIDC_USER_PASSWORD}" }]
    },
    {
      "username": "inconnue",
      "email": "inconnue@example.org",
      "emailVerified": true,
      "firstName": "Personne",
      "lastName": "Inconnue",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${E2E_OIDC_USER_PASSWORD}" }]
